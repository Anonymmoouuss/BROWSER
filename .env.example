# Database (SQLite). IMPORTANT:
# - `file:` paths are resolved relative to prisma/schema.prisma, so
#   `file:../db/custom.db` points at <project>/db/custom.db.
# - If you hit "database not found" errors at runtime, switch to an ABSOLUTE
#   path instead, e.g. file:/home/YOU/scramjet-workspace/db/custom.db
# - After changing this value, re-run: bun run db:generate
DATABASE_URL=file:../db/custom.db

# Vercel only: the HTTPS origin of the persistent backend gateway.
# Leave unset on the backend host and for the all-local stack.
# BACKEND_ORIGIN=https://scramjet-backend.example.com

# Optional local gateway listener; container hosting sets this from PORT.
# CADDY_ADDRESS=:8080
